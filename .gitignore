# Build output, including UI snapshots written to target/ui-snapshots
/target/

# Local caches and databases (mr.de keeps its own in ~/Library/Caches/mrde)
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Secrets and local configuration: never commit them
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Screenshots of the real application contain private merge requests
mrde-real-*.png

# Editors and operating system
.DS_Store
.idea/
.vscode/
*.swp
*~
